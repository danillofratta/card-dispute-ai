# Copy to .env for local development. .env is git-ignored: never commit it.

# Postgres started by docker compose. Without DATABASE_URL the API keeps data in memory.
DATABASE_URL=postgresql+asyncpg://dispute:dispute@localhost:5432/disputes

# Optional: change the host ports if 5432 or 8000 are already in use.
# POSTGRES_PORT=5432
# API_PORT=8000

# Approvals above this amount (BRL) wait for a human. The evals dataset expects 500.00.
# APPROVAL_LIMIT=500.00

# The analysis model. Without LLM_PROVIDER, every analysis goes to manual review.
# Groq has a free tier and an OpenAI-compatible API (key at https://console.groq.com):
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
#
# Other providers: LLM_PROVIDER=openai (OpenAI itself, no LLM_BASE_URL), LLM_PROVIDER=anthropic,
# or LLM_PROVIDER=ollama with LLM_BASE_URL=http://localhost:11434 and no key.
# The whole analysis must finish within this many seconds:
# LLM_TIMEOUT_SECONDS=60

# Tracing in Langfuse. Without both keys, nothing is traced.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000
